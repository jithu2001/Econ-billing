# ============================================
# Econ — Wails (Go + React/Vite) .gitignore
# ============================================

# ==================
# Database
# ==================
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.backup
*.sqlite
*.sqlite3

# ==================
# Go
# ==================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/
go.work
go.work.sum

# ==================
# Frontend (React / Vite)
# ==================
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo
*.local

# Wails frontend build-cache marker
frontend/package.json.md5

# NOTE: frontend/wailsjs/ is generated by `wails generate module` but is
# intentionally TRACKED — frontend/src imports from it and `tsc -b` needs it
# to exist before the bindings step can run on a fresh clone.

# ==================
# Wails build output
# ==================
build/bin/

# ==================
# Secrets & environment
# ==================
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.yml
jwt_secret.txt
config.production.json
!.env.example

# ==================
# App-generated output
# ==================
reports/
exports/
uploads/
/*.csv
/*.pdf
/*.xlsx

# ==================
# Logs, temp, profiling
# ==================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig
*.prof
*.trace

# ==================
# Coverage
# ==================
coverage/
*.cover
.nyc_output/

# ==================
# Editors & OS
# ==================
.vscode/
.idea/
*.iml
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==================
# Tooling
# ==================
.claude/
.task-*/
